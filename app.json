{
  "expo": {
    "name": "Ladra_M",
    "slug": "Ladra_M",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.jpeg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.jpeg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ladra.mjladra",
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/icon.jpeg"
    },
    "plugins": [
      "expo-sqlite"
    ],
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "de3cd814-3c99-486f-b798-1f4da21f72b4"
      }
    }
  }
}
